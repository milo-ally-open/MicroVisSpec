[Unit]
Description=Yunshao Atlas classroom behavior runtime
After=network-online.target yunshao-agent.service
Wants=network-online.target yunshao-agent.service

[Service]
Type=simple
User=yunshao
Group=yunshao
SupplementaryGroups=video HwHiAiUser HwBaseUser
EnvironmentFile=/etc/yunshao/cann.env
EnvironmentFile=-/etc/yunshao/classroom-runtime.env
ExecStart=/usr/local/bin/yunshao-classroom-runtime
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
# Atlas CANN/ACL requires the host filesystem and shared temporary namespace.
# Validate CANN/driver IPC compatibility on-device before adding filesystem isolation.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
