# The backend Compose project creates this shared Docker network.
BACKEND_NETWORK=yunshao_backend

# Keep localhost-only for development; set a reachable host address for deployment.
WEB_BIND_ADDRESS=127.0.0.1
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
WEB_HTTPS_REDIRECT_PORT=443

# Optional second host interface for Atlas activation when it uses a separate link.
# Set this only when deploying with docker-compose.atlas.yaml.
# WEB_ATLAS_BIND_ADDRESS=192.168.0.1
