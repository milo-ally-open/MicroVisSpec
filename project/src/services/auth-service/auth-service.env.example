AUTH_LISTEN_ADDRESS=127.0.0.1:18081
DATABASE_URL_FILE=/etc/microvisspec/auth-database-url
PUBLIC_ORIGIN=https://your-domain.example
AUTH_COOKIE_SECURE=true
AUTH_INTERNAL_SERVICE_TOKEN_FILE=/etc/microvisspec/auth-internal-service-token
AUTH_DEVICE_SERVICE_URL=http://127.0.0.1:18082
AUTH_EVENT_SERVICE_URL=http://127.0.0.1:18083
AUTH_DEVICE_SERVICE_TOKEN_FILE=/etc/microvisspec/device-internal-service-token
AUTH_MEDIA_SERVICE_URL=http://127.0.0.1:18084
AUTH_MEDIA_SERVICE_TOKEN_FILE=/etc/microvisspec/auth-media-service-token
AUTH_PUSH_SERVICE_URL=http://127.0.0.1:18085
AUTH_PUSH_SERVICE_TOKEN_FILE=/etc/microvisspec/auth-push-service-token
# Set only for the one-time internal admin bootstrap operation, then remove.
AUTH_ADMIN_BOOTSTRAP_TOKEN_FILE=/etc/microvisspec/auth-admin-bootstrap-token
