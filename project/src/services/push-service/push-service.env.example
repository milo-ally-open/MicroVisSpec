PUSH_LISTEN_ADDRESS=127.0.0.1:18085
DATABASE_URL_FILE=/etc/microvisspec/push-database-url
PUBLIC_ORIGIN=https://your-domain.example
PUSH_VAPID_PUBLIC_KEY_FILE=/etc/microvisspec/push-vapid-public-key
PUSH_VAPID_PRIVATE_KEY_FILE=/etc/microvisspec/push-vapid-private-key
PUSH_VAPID_SUBJECT=mailto:ops@your-domain.example
PUSH_ENCRYPTION_KEY_FILE=/etc/microvisspec/push-encryption-key
AUTH_SERVICE_INTERNAL_URL=http://127.0.0.1:18081
PUSH_AUTH_SERVICE_TOKEN_FILE=/etc/microvisspec/auth-push-service-token
PUSH_EVENT_SERVICE_TOKEN_FILE=/etc/microvisspec/event-push-service-token
