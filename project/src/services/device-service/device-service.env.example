DEVICE_LISTEN_ADDRESS=127.0.0.1:18082
DATABASE_URL_FILE=/etc/microvisspec/device-database-url
MQTT_BROKER_URL=ssl://mqtt.your-domain.example:8883
MQTT_ADVERTISED_BROKER_URL=ssl://mqtt.your-domain.example:8883
MQTT_CA_FILE=/etc/microvisspec/mqtt-ca-certificate.pem
MQTT_ADMIN_USERNAME=admin
MQTT_ADMIN_PASSWORD_FILE=/etc/microvisspec/mqtt-admin-password
MQTT_DEVICE_SERVICE_USERNAME=yunshao-device-service
MQTT_DEVICE_SERVICE_PASSWORD_FILE=/etc/microvisspec/mqtt-device-service-password
MQTT_EVENT_SERVICE_USERNAME=yunshao-event-service
MQTT_EVENT_SERVICE_PASSWORD_FILE=/etc/microvisspec/mqtt-event-service-password
ATLAS_ACTIVATION_ORIGIN=https://your-domain.example
ATLAS_ACTIVATION_CA_FILE=/etc/microvisspec/atlas-activation-ca-certificate.pem
ATLAS_BOOTSTRAP_BUNDLE_FILE=/opt/microvisspec/atlas200idka2-bootstrap.tar.gz
ATLAS_SSH_ALLOWED_CIDRS=192.168.0.0/16
DEVICE_INTERNAL_SERVICE_TOKEN_FILE=/etc/microvisspec/device-internal-service-token
MEDIA_SERVICE_INTERNAL_URL=http://127.0.0.1:18084
MEDIA_SERVICE_INTERNAL_TOKEN_FILE=/etc/microvisspec/device-media-service-token
