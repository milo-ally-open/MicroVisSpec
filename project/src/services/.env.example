# Copy to .env and set deployment addresses. Prepare secret files separately.
COMPOSE_PROJECT_NAME=yunshao
BACKEND_NETWORK=yunshao_backend

# Public browser and edge endpoint. Use a DNS name or reachable host IP.
PUBLIC_HOST=localhost
PUBLIC_ORIGIN=https://localhost
# Atlas must reach this listener; use a routable host address and firewall rule.
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_TLS_PORT=8883
# TLS URL returned by device activation. Route it to the broker listener and use a trusted certificate.
MQTT_ADVERTISED_BROKER_URL=ssl://mqtt.your-domain.example:8883

POSTGRES_DB=yunshao
POSTGRES_USER=yunshao_bootstrap
VAPID_SUBJECT=mailto:ops@example.invalid
