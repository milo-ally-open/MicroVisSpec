EVENT_LISTEN_ADDRESS=127.0.0.1:18083
DATABASE_URL_FILE=/etc/microvisspec/event-database-url
MQTT_BROKER_URL=ssl://localhost:8883
MQTT_CA_FILE=/etc/microvisspec/mqtt-ca-certificate.pem
MQTT_EVENT_SERVICE_USERNAME=yunshao-event-service
MQTT_EVENT_SERVICE_PASSWORD_FILE=/etc/microvisspec/mqtt-event-service-password
DEVICE_SERVICE_INTERNAL_URL=http://127.0.0.1:18082
DEVICE_SERVICE_INTERNAL_TOKEN_FILE=/etc/microvisspec/device-internal-service-token
AUTH_SERVICE_INTERNAL_URL=http://127.0.0.1:18081
PUSH_SERVICE_INTERNAL_URL=http://127.0.0.1:18085
PUSH_SERVICE_INTERNAL_TOKEN_FILE=/etc/microvisspec/event-push-service-token
EVENT_CURSOR_SIGNING_KEY_FILE=/etc/microvisspec/event-cursor-signing-key
EVENT_EVIDENCE_DIR=/var/lib/microvisspec/evidence
